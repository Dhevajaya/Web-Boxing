# ============================================================
#  .env PRODUKSI (contoh). Salin ke server sebagai .env lalu isi.
#  JANGAN commit file .env yang sudah berisi rahasia.
# ============================================================
APP_NAME="Web Boxing"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # php artisan key:generate --show, tempel hasilnya di sini
APP_TIMEZONE=UTC               # biarkan UTC; jadwal game memakai Asia/Jakarta dari config/game.php
APP_URL=https://domainmu.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL dari hPanel → Databases → MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_boxing
DB_USERNAME=u123456789_boxing
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=129600        # 90 hari, dalam menit
SESSION_SECURE_COOKIE=true     # wajib true di HTTPS
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync          # game tidak memakai worker antrean
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# --- Identitas game ---
GAME_NAME="KAMPUNG TENDANG"
GAME_TAGLINE="Dari Gang, Naik Gelanggang."
GAME_INSTAGRAM=akunresmi       # tanpa @
GAME_DM_KEYWORD=KAMPUNGTENDANG
GAME_BUSINESS_EMAIL=           # muncul di halaman Privasi untuk permintaan hapus data

AUTH_DEV_LOGIN=false           # WAJIB false di produksi

# --- Instagram API (lihat docs/instagram-setup.md) ---
INSTAGRAM_GRAPH_VERSION=v26.0
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# --- Dukung (opsional) ---
SUPPORT_SAWERIA_URL=           # https://saweria.co/akunmu
SUPPORT_WEBHOOK_TOKEN=         # string acak panjang, mis. hasil: php -r "echo bin2hex(random_bytes(20));"

# Admin pertama dibuat dengan: php artisan admin:create emailmu@contoh.com
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
