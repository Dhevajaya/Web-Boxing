APP_NAME="Web Boxing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Lokal paling mudah pakai SQLite. Produksi: mysql.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=web_boxing
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=129600
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Identitas game (bisa juga diubah di config/game.php) ---
GAME_NAME="Web Boxing"
GAME_TAGLINE="Naik ring, buktikan namamu."
GAME_INSTAGRAM=akunresmi
GAME_DM_KEYWORD=GELUD
GAME_BUSINESS_EMAIL=

# Login sebagai username apa pun TANPA Instagram. Hanya aktif bila APP_ENV=local.
AUTH_DEV_LOGIN=true

# --- Instagram API with Instagram Login (isi di server, jangan di-commit) ---
INSTAGRAM_GRAPH_VERSION=v26.0
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# --- Dukung (opsional): tautan Saweria dan token rahasia webhook /api/webhooks/saweria/{token} ---
SUPPORT_SAWERIA_URL=
SUPPORT_WEBHOOK_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# Admin pertama (dibuat oleh GameSeeder bila keduanya diisi)
ADMIN_EMAIL=
ADMIN_PASSWORD=
